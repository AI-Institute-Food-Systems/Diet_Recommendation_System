    "cond_dim": 256,
    "film_blocks": 3,
    "lambda_ac": 0.9,
    "guidance_drop_prob": 0.5,
    "meal_guidance_drop_prob": 0.3,
    "kl_weight": 1,
    "kl_annealing_epochs": 10,
    "presence_pos_weight_max": 15,
    "ac_detach": false
  },
  "monitor": {
    "enabled": true,
    "every": 2,
    "G": 1000,
    "coverage_n": 1000,
    "bootstraps": 200,
    "early_stop": false,
    "patience": 8,
    "min_delta": 0.002,
    "csv_name": "diversity_monitor.csv",
    "seed": 123
  }
